# DataPulse AI Environment Configuration
APP_NAME="DataPulse AI"
APP_VERSION="0.3.0"
DEBUG=True

# Database Configuration (PostgreSQL primary)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/datapulse_ai"
# Fallback local database path (used automatically if PostgreSQL is unreachable)
SQLITE_FALLBACK_URL="sqlite:///./datapulse.db"

# Ingestion Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR="./uploads"

# Google Gemini AI Configuration (Milestone 3)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Authentication (Milestone 5)
JWT_SECRET_KEY="your-super-secret-jwt-key-min-32-chars-replace-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Caching (Milestone 6)
REDIS_ENABLED=true
# REDIS_URL="redis://:password@localhost:6379/0" # Optional: overrides host/port/db
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=1.0
REDIS_KEY_PREFIX="datapulse"

# Cache TTL Configurations (in seconds)
CACHE_TTL_OVERVIEW_SUMMARY=60
CACHE_TTL_DATASET_LIST=120
CACHE_TTL_DATASET_DETAIL=300
CACHE_TTL_PIPELINE_LIST=30
CACHE_TTL_PIPELINE_DETAIL=30
CACHE_TTL_PIPELINE_METRICS=15
CACHE_TTL_PIPELINE_ALERTS=20
